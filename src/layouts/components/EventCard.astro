---
interface BaseEvent {
  title: string;
  date: string;
  /** Format: "YYYY-MM-DD" — used for automatic expiration and semantic <time> */
  isoDate: string;
  time: string;
  description: string;
}

export interface InPersonEvent extends BaseEvent {
  location: string;
  address?: string;
  studentLink: string;
  counselorLink?: string;
}

export interface VirtualEvent extends BaseEvent {
  featuredInstitutions?: string;
  registrationLink: string;
}

export interface Props extends BaseEvent {
  type: "in-person" | "virtual";
  location?: string;
  address?: string;
  studentLink?: string;
  counselorLink?: string;
  featuredInstitutions?: string;
  registrationLink?: string;
}

/**
 * Keeps an event visible until a full calendar day after its date has elapsed
 * (e.g., an event on Sept 27 stays visible through Sept 28 and expires Sept 29 at 12:00 AM).
 */
export function isEventUpcoming(isoDate: string): boolean {
  const [year, month, day] = isoDate.split("-").map(Number);
  if (!year || !month || !day) return true;
  const expirationDate = new Date(year, month - 1, day + 2);
  return new Date() < expirationDate;
}

const {
  type,
  title,
  date,
  isoDate,
  time,
  description,
  location,
  address,
  studentLink,
  counselorLink,
  featuredInstitutions,
  registrationLink,
} = Astro.props;

const isInPerson = type === "in-person";
---

<article class="bg-white border-2 border-primary/10 p-6 rounded-xl shadow-sm hover:border-primary/30 transition-all duration-300 flex flex-col justify-between w-full">
  <div>
    <!-- Date & Modality Header -->
    <div class="mb-4 pb-3 border-b border-slate-100">
      <time datetime={isoDate} class="block text-text font-bold text-lg leading-tight">
        {date}
      </time>
      <span class="block text-slate-500 text-sm font-medium mt-1">
        {time} &bull; {isInPerson ? "In-Person" : "Virtual Session"}
      </span>
    </div>

    <!-- Event Title -->
    <h3 class="h6 text-xl font-primary mb-4 leading-snug text-text">
      {title}
    </h3>

    <!-- Modality-Specific Metadata -->
    {isInPerson ? (
      location && (
        <p class="text-sm font-semibold text-slate-700 mb-4">
          {location}
          {address && (
            <span class="block font-normal text-slate-500 text-xs mt-0.5">
              {address}
            </span>
          )}
        </p>
      )
    ) : (
      featuredInstitutions && (
        <p class="text-sm font-semibold text-slate-700 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-0.5">
            Featured Institutions
          </span>
          {featuredInstitutions}
        </p>
      )
    )}

    <!-- Event Description -->
    <p class="text-slate-600 text-lg mb-6 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-col gap-3 mt-auto pt-2">
    {isInPerson ? (
      <>
        {studentLink && (
          <a
            href={studentLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center font-bold px-6 py-3.5 bg-primary btn btn-primary no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text tracking-wide text-center"
          >
            Student Registration
            <span class="sr-only"> for {title}</span>
          </a>
        )}

        {counselorLink && (
          <a
            href={counselorLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center font-semibold text-sm px-4 py-2 border-2 border-primary/20 text-primary rounded-lg hover:border-primary hover:bg-primary/5 transition-colors no-underline text-center"
          >
            Counselor Registration
            <span class="sr-only"> for {title}</span>
          </a>
        )}
      </>
    ) : (
      registrationLink && (
        <a
          href={registrationLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center font-bold px-6 py-3.5 bg-primary btn btn-primary no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text tracking-wide text-center"
        >
          Register for Virtual Session
          <span class="sr-only">: {title}</span>
        </a>
      )
    )}
  </div>
</article>

<script>
  function filterExpiredEvents() {
    const grid = document.getElementById("upcoming-events-grid");
    const emptyState = document.getElementById("no-upcoming-events");
    if (!grid) return;

    const now = new Date();
    const items = grid.querySelectorAll<HTMLElement>("[data-event-item]");
    let visibleCount = 0;

    items.forEach((item) => {
      const isoDate = item.dataset.eventDate;
      if (!isoDate) {
        visibleCount++;
        return;
      }

      const [year, month, day] = isoDate.split("-").map(Number);
      const expirationDate = new Date(year, month - 1, day + 2);

      if (now >= expirationDate) {
        item.classList.add("hidden");
        item.classList.remove("flex");
      } else {
        visibleCount++;
      }
    });

    if (visibleCount === 0) {
      grid.classList.add("hidden");
      emptyState?.classList.remove("hidden");
    }
  }

  filterExpiredEvents();
  document.addEventListener("astro:page-load", filterExpiredEvents);
</script>