---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import CTA from "@/components/CTA.astro";

import inPersonImg from "@/assets/images/in-person-cover.jpg";
import virtualImg from "@/assets/images/virtual-cover.jpg";
import campusBg from "@/assets/images/bgs/campus-life.jpg";
---

<Base>
  <section class="section">
    <div class="container py-32">
      <div class="row content-center gx-4">
        <div class="col-12 md:col-8">
          <Image
            src="/images/story-logo.png"
            alt="A bird."
            width="800"
            height="570"
          />
        </div>

        <div class="col-12 md:col-4 content-center">
          <h1>Welcome to STORY</h1>
          <p class="py-4 text-lg">
            The STORY Consortium is committed to empowering rural & small-town
            students – and the communities that support them – by preparing them
            for the college search and application process, with an aim of
            expanding access to higher education.
          </p>
          <a
            href="/about"
            class="btn btn-primary mt-2 w-full no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text text-center tracking-wide"
          >
            About STORY
          </a>
          <a
            href="/institutions"
            class="btn btn-primary mt-2 w-full no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text text-center tracking-wide"
          >
            STORY institutions
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="section relative overflow-hidden bg-story-bg">
    <div class="container py-16 z-10 relative">
      <div class="row">
        <div class="col-12 text-center">
          <h2 class="text-light mb-8">Your STORY Starts Here</h2>
          
          <div class="max-w-6xl mx-auto rounded-xl overflow-hidden shadow-xl border-2 border-white/10 transform-gpu will-change-transform">
            <iframe
              class="w-full aspect-video"
              src="https://www.youtube.com/embed/pOfZWnHiOrI?si=FEPjw_zHasj9i-H3&amp;controls=0"
              title="STORY Institutions Video Presentation"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>

        </div>
      </div>
    </div>
  </section>
  <section class="section">
  <div class="container py-16">
    <div class="row">
      <div class="col-12 text-center mb-12">
        <h2 class="border-b-8 border-accent-red py-4 m-0 inline-block">Visit STORY</h2>
      </div>
    </div>

    <div class="row g-6 max-w-5xl justify-self-center">
      
      <!-- In-Person Events Card -->
      <div class="col-12 md:col-6 flex">
        <div class="bg-white border-2 border-primary/10 rounded-xl shadow-sm hover:border-primary/30 transition-all duration-300 flex flex-col justify-between overflow-hidden w-full group">
          
          <div>
            <!-- Cover Image Container -->
              <Image
                src={inPersonImg}
                alt="Students attending an in-person STORY event"
                width={600}
                height={400}
                class="w-full h-52 object-cover group-hover:scale-[1.03] transition-transform duration-300 not-prose"
              />
            

            <!-- Content Area -->
            <div class="p-6">

              <h3 class="h6 text-2xl font-primary mb-3 text-text  transition-colors">
                  In-Person Events
              </h3>

              <p class="text-slate-600 text-base leading-relaxed mb-6">
                Learn more about which region we will travel to next, view detailed location information, and discover where we have traveled previously.
              </p>
            </div>
          </div>

          <!-- Card Action Button -->
          <div class="px-6 pb-6 mt-auto">
            <a 
              href="/in-person-events" 
              class="w-full flex items-center justify-center font-bold px-6 py-3.5 bg-primary btn btn-primary no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text tracking-wide text-center"
            >
              Explore In-Person Events
            </a>
          </div>

        </div>
      </div>

      <!-- Virtual Events Card -->
      <div class="col-12 md:col-6 flex">
        <div class="bg-white border-2 border-primary/10 rounded-xl shadow-sm hover:border-primary/30 transition-all duration-300 flex flex-col justify-between overflow-hidden w-full group">
          
          <div>
            <!-- Cover Image Container -->
              <Image
                src={virtualImg}
                alt="Student participating in a virtual STORY webinar"
                width={600}
                height={400}
                class="w-full h-52 object-cover group-hover:scale-[1.03] transition-transform duration-300 not-prose"
              />

            <!-- Content Area -->
            <div class="p-6">

              <h3 class="h6 text-2xl font-primary mb-3 text-text  transition-colors">
                
                  Virtual Events
                
              </h3>

              <p class="text-slate-600 text-base leading-relaxed mb-6">
                Explore specific admissions topics, application guidance, and member institutions through our live virtual programming schedule.
              </p>
            </div>
          </div>

          <!-- Card Action Button -->
          <div class="px-6 pb-6 mt-auto">
            <a 
              href="/virtual-events" 
              class="w-full flex items-center justify-center font-bold px-6 py-3.5 bg-primary btn btn-primary no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text tracking-wide text-center"
            >
              View Virtual Schedule
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

  <CTA />
</Base>
