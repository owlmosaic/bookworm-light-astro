---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import CTA from "@/components/CTA.astro";

import inPersonImg from "@/assets/images/in-person-cover.jpg";
import virtualImg from "@/assets/images/virtual-cover.jpg";
import campusBg from "@/assets/images/bgs/campus-life.jpg";
---

<Base>
  <section class="section">
    <div class="container py-32">
      <div class="row content-center gx-4">
        <div class="col-12 md:col-8">
          <Image
            src="/images/story-logo.png"
            alt="A bird."
            width="800"
            height="570"
          />
        </div>

        <div class="col-12 md:col-4 content-center">
          <h1>Welcome to STORY</h1>
          <p class="py-4 text-lg">
            The STORY Consortium is committed to empowering rural & small-town
            students – and the communities that support them – by preparing them
            for the college search and application process, with an aim of
            expanding access to higher education.
          </p>
          <a
            href="/about"
            class="btn btn-primary mt-2 w-full no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text text-center tracking-wide"
          >
            About STORY
          </a>
          <a
            href="/institutions"
            class="btn btn-primary mt-2 w-full no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text text-center tracking-wide"
          >
            STORY institutions
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="section relative overflow-hidden bg-story-bg">
    <div class="container py-16 z-10 relative">
      <div class="row">
        <div class="col-12 text-center">
          <h2 class="text-light mb-8">Your STORY Starts Here</h2>
          
          <div class="max-w-6xl mx-auto rounded-xl overflow-hidden shadow-xl border-2 border-white/10 transform-gpu will-change-transform">
            <iframe
              class="w-full aspect-video"
              src="https://www.youtube.com/embed/pOfZWnHiOrI?si=FEPjw_zHasj9i-H3&amp;controls=0"
              title="STORY Institutions Video Presentation"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>

        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container py-16">
      <div class="row">
        <div class="col-12 md:col-8 md:offset-2 mb-8">
          <h2 class="text-center">Visit STORY</h2>
        </div>
        <div class="col-12 md:col-6">
          <a
            href="/in-person-events"
            class="block hover:text-primary overflow-hidden group"
          >
            <Image
              src={inPersonImg}
              alt="placeholder"
              width={600}
              height={400}
              class="group-hover:scale-[1.03] transition duration-300 w-full not-prose"
            />
          </a>
          <h3 class="text-2xl my-4 font-primary">
            <a href="/in-person-events" class="">In-person Events</a>
          </h3>
          <p class="my-4">
            Learn more about which region we will travel to next (and where we
            have been previously).
          </p>
        </div>
        <div class="col-12 md:col-6">
          <a
            href="/virtual-events"
            class="block hover:text-primary overflow-hidden group"
          >
            <Image
              src={virtualImg}
              alt="placeholder"
              width={600}
              height={400}
              class="group-hover:scale-[1.03] transition duration-300 w-full not-prose"
            />
          </a>
          <h3 class="text-2xl my-4 font-primary">
            <a href="/virtual-events" class="">Virtual Events</a>
          </h3>
          <p class="my-4">
             Explore specific topics and institutions through our virtual programming.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Base>
