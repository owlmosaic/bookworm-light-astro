---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import CTA from "@/components/CTA.astro";

// Structured Event Data
const upcomingEvents = [
  {
    title: "STORY Session with Cornell University, University of Chicago, University of Maryland, Washington & Lee University, and Wellesley College",
    date: "Tuesday, October 13",
    time: "7:00 - 8:15 pm ET",
    featuredInstitutions: "Cornell University, University of Chicago, University of Maryland, Washington & Lee University, and Wellesley College",
    description: "Join five STORY representatives and learn more about their institutions, holistic admissions, advice for the application process, and information about financial aid.",
    registrationLink: "https://access.wlu.edu/register/?id=f717bda0-5a11-44de-97de-9dc5417ccff8"
  }
];
---

<Base title="Virtual Events">
  <section class="section">
    <div class="container content">
      <div class="row md:gx-4">
        <div class="col-10 offset-1 md:col-4 md:offset-4 sm:col-8 sm:offset-2">
          <Image
            src="/images/story-logo.png"
            alt="STORY Logo"
            width={800}
            height={570}
          />
        </div>
      </div>
      <div class="row my-12">
        <div class="col-12 lg:col-4 lg:border-r-8 border-primary pt-4">
          <h1 class="border-b-8 lg:text-center lg:border-b-0 border-primary py-4 m-0">Virtual Events</h1>
        </div>
        <div class="col-12 lg:col-8 prose prose-slate prose-xl max-w-none">
          <p class="mt-0 pt-4">
            Our virtual programming will feature sessions and workshops on all aspects of the college application process. Among other topics, you'll learn about application requirements and timelines, how to showcase your strengths in the application, and receive advice tailored specifically for rural students. Additionally, select STORY partners will host collaborative information sessions about their individual schools throughout the year.
          </p>
        </div>
      </div>
      
      <div class="row">
        <div class="col-12 text-center py-4">
          <h2 class="border-b-8 border-accent-red py-4 m-0 inline-block">Upcoming Events</h2>
        </div>
      </div>

      <!-- Dynamically Mapped Upcoming Events Grid -->
      <div class="row justify-self-center g-6 gy-4 mb-12">
        {upcomingEvents.map((event) => (
          <div class="col-12 lg:col-6 flex">
            <div class="bg-white border-2 border-primary/10 p-6 rounded-xl shadow-sm hover:border-primary/30 transition-all duration-300 flex flex-col justify-between w-full">
              
              <div>
                <!-- Date & Modality Banner -->
                <div class="mb-4 pb-3 border-b border-slate-100">
                  <span class="block text-text font-bold text-lg leading-tight">
                    {event.date}
                  </span>
                  <span class="block text-slate-500 text-sm font-medium mt-1">
                    {event.time} &bull; Virtual Session
                  </span>
                </div>

                <!-- Event Title -->
                <h3 class="h6 text-xl font-primary mb-4 leading-snug text-text">
                  {event.title}
                </h3>

                <!-- Featured Institutions -->
                {event.featuredInstitutions && (
                  <p class="text-sm font-semibold text-slate-700 mb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-0.5">Featured Institutions</span>
                    {event.featuredInstitutions}
                  </p>
                )}

                <!-- Description -->
                <p class="text-slate-600 text-lg mb-6 leading-relaxed">
                  {event.description}
                </p>
              </div>

              <!-- Registration Button -->
              <div class="flex flex-col gap-4 mt-auto pt-2">
                <a 
                  href={event.registrationLink} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full flex items-center justify-center font-bold px-6 py-3.5 bg-primary btn btn-primary no-underline uppercase hover:bg-secondary hover:border-secondary hover:text-text tracking-wide text-center"
                >
                  Register for Virtual Session
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
  <CTA />
</Base>