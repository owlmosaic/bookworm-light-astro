---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import CTA from "@/components/CTA.astro";
import EventCard, {
  isEventUpcoming,
  type VirtualEvent,
} from "@/components/EventCard.astro";

// Structured Event Data (add items here as virtual sessions are scheduled)
const upcomingEvents: VirtualEvent[] = [
  // {
  //   title: "STORY Virtual Information Session",
  //   date: "Tuesday, October 13",
  //   isoDate: "2026-10-13",
  //   time: "7:00 - 8:15 pm ET",
  //   featuredInstitutions: "Partner Colleges & Universities",
  //   description: "Join STORY representatives to learn more about holistic admissions, the application process, and financial aid.",
  //   registrationLink: "https://example.com/register",
  // },
];

const activeEvents = upcomingEvents.filter((event) =>
  isEventUpcoming(event.isoDate)
);
---

<Base title="Virtual Events">
  <section class="section">
    <div class="container content">
      <div class="row md:gx-4">
        <div class="col-10 offset-1 md:col-4 md:offset-4 sm:col-8 sm:offset-2">
          <Image
            src="/images/story-logo.png"
            alt="STORY Logo"
            width={800}
            height={570}
          />
        </div>
      </div>

      <div class="row my-12">
        <div class="col-12 lg:col-4 lg:border-r-8 border-primary pt-4">
          <h1 class="border-b-8 lg:text-center lg:border-b-0 border-primary py-4 m-0">
            Virtual Events
          </h1>
        </div>
        <div class="col-12 lg:col-8 prose prose-slate prose-xl max-w-none">
          <p class="mt-0 pt-4">
            Our virtual programming will feature sessions and workshops on all aspects of the college application process. Among other topics, you'll learn about application requirements and timelines, how to showcase your strengths in the application, and receive advice tailored specifically for rural students. Additionally, select STORY partners will host collaborative information sessions about their individual schools throughout the year.
          </p>
        </div>
      </div>

      <div class="row">
        <div class="col-12 text-center py-4">
          <h2 class="border-b-8 border-accent-red py-4 m-0 inline-block">
            Upcoming Events
          </h2>
        </div>
      </div>

      <!-- Dynamically Mapped Upcoming Events Grid -->
      {activeEvents.length > 0 && (
        <div
          id="upcoming-events-grid"
          class="row justify-self-center g-6 gy-4 mb-12"
        >
          {activeEvents.map((event) => (
            <div
              class="col-12 lg:col-6 flex"
              data-event-item
              data-event-date={event.isoDate}
            >
              <EventCard type="virtual" {...event} />
            </div>
          ))}
        </div>
      )}

      <!-- Empty State Fallback -->
      <div
        id="no-upcoming-events"
        aria-live="polite"
        class:list={[
          "row justify-self-center prose prose-slate prose-xl text-center py-6 mb-12",
          { hidden: activeEvents.length > 0 },
        ]}
      >
        <p>
          Check back in January for details on our Spring 2027 virtual events.
        </p>
      </div>
    </div>
  </section>
  <CTA />
</Base>